{
  "tripslop": 1,
  "name": "Showroom",
  "description": "3D objects on a turntable: a chrome teapot over a synthwave sun, a wireframe bunny, a toon dragon that comes apart on the beat, and footage wrapped around a spinning prism.",
  "bpm": 100,
  "quantize": "beat",
  "scenes": ["Teapot", "Bunny", "Dragon", "Prism"],
  "layers": [
    {
      "name": "Backdrop",
      "params": { "transition": 1 },
      "clips": [
        { "library": "Retro Sun" },
        { "library": "Infinite Grid" },
        { "library": "Wireframe Corridor" },
        { "library": "Fog Cathedral" }
      ]
    },
    {
      "name": "Object",
      "effects": [ { "kind": "echo", "params": { "amount": 0.4, "spacing": 3, "decay": 0.6 } } ],
      "clips": [
        { "model": "Utah Teapot", "params": { "material": "Chrome", "size": 1, "spin y": 0.25, "y": -0.05 } },
        { "model": "Stanford Bunny", "params": { "material": "Hologram", "wire": 1, "wire width": 1.5, "spin y": -0.25, "hue": { "mod": { "shape": "saw_up", "beats": 16, "depth": 1 } } } },
        { "model": "Stanford Dragon", "params": { "material": "Toon", "size": 1.2, "spin y": 0.125, "explode": { "mod": { "shape": "envelope", "beats": 1, "depth": 0.08, "polarity": "up", "points": [[0, 0], [0.05, 1], [0.5, 0]] } }, "background": "Transparent" } }
      ]
    },
    {
      "name": "Prism",
      "effects": [
        { "kind": "shape_projector", "params": { "shape": "Prism", "sides": 6, "size": 0.55, "height": 1.3, "spin y": 0.25, "rotate x": { "mod": { "shape": "sine", "beats": 16, "depth": 0.1 } }, "lighting": 0.8 } }
      ],
      "clips": [
        null, null, null,
        { "file": "../samples/jellyfish.mp4", "fallback": { "file": "../samples/pillars-of-creation.jpg" } }
      ]
    }
  ]
}
