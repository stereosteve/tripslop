{
  "tripslop": 1,
  "name": "Patch Bay",
  "description": "An analog video synthesizer with nothing but oscillators: rings, checkerboards, bars and plasma, each shrunk into its own feedback loop, from a slow mandala to a melting tunnel.",
  "bpm": 110,
  "quantize": "bar",
  "scenes": ["Mandala", "Tunnel", "Hall of mirrors", "Melt"],
  "effects": [
    { "kind": "color", "params": { "hue": { "mod": { "shape": "smooth_random", "beats": 32, "depth": 0.3 } }, "saturation": 1.15, "contrast": 1.05 } },
    { "kind": "wave", "params": { "amplitude": 0.002, "frequency": 24, "speed": 3 } }
  ],
  "layers": [
    {
      "name": "Mandala",
      "effects": [
        { "kind": "transform", "params": { "zoom": 0.35 } },
        { "kind": "feedback", "preset": "Mandala", "params": { "input mode": "Luma key", "key threshold": 0.2 } }
      ],
      "clips": [
        { "generator": "rings", "params": { "frequency": 5, "hue": { "mod": { "shape": "saw_up", "beats": 16, "depth": 1 } } } }
      ]
    },
    {
      "name": "Tunnel",
      "effects": [
        { "kind": "transform", "params": { "zoom": { "value": 0.3, "mod": { "shape": "sine", "beats": 8, "depth": 0.03 } }, "rotate": 10 } },
        { "kind": "feedback", "preset": "Tunnel", "params": { "hue / pass": 0.03, "input mode": "Luma key", "key threshold": 0.2 } }
      ],
      "clips": [
        null,
        { "generator": "checker", "params": { "frequency": 4, "pattern speed": 1.5, "hue": 0.55 } }
      ]
    },
    {
      "name": "Hall of mirrors",
      "effects": [
        { "kind": "transform", "params": { "zoom": 0.4, "rotate": { "value": 45, "mod": { "shape": "triangle", "beats": 32, "depth": 0.25 } } } },
        { "kind": "feedback", "preset": "Hall of mirrors" }
      ],
      "clips": [
        null, null,
        { "generator": "bars", "params": { "frequency": 3, "pattern speed": 2, "hue": { "mod": { "shape": "sine", "beats": 16, "depth": 0.4 } } } }
      ]
    },
    {
      "name": "Melt",
      "effects": [
        { "kind": "transform", "params": { "zoom": 0.5 } },
        { "kind": "feedback", "preset": "Melt" }
      ],
      "clips": [
        null, null, null,
        { "generator": "plasma", "params": { "frequency": 3, "pattern speed": 0.8 } }
      ]
    },
    {
      "name": "Sync bars",
      "blend": "add",
      "params": { "opacity": { "value": 0.05, "mod": { "shape": "square", "beats": 2, "depth": 0.08, "polarity": "up" } } },
      "clips": [
        { "generator": "bars", "params": { "frequency": 40, "pattern speed": 0.2 } },
        { "generator": "bars", "params": { "frequency": 40, "pattern speed": 0.2 } },
        { "generator": "bars", "params": { "frequency": 40, "pattern speed": 0.2 } },
        { "generator": "bars", "params": { "frequency": 40, "pattern speed": 0.2 } }
      ]
    }
  ]
}
