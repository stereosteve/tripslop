# 3D models: model clips with each material, models from files, and models as the object of
# the Shape projector and Projection mapping.
# Run from the repo root:  cargo run --release -- --script scripts/models.tripslop

# A model clip, in each material. Spin off for comparable stills.
model 1 1 Utah Teapot
launch 1 1
set "1/clip/spin y" 0
set "1/clip/rotate y" 30
assert triangles 1 1 > 6000
at 10  snapshot target/script-out/models/01-teapot-surface.png
at 11  set 1/clip/material 1
at 20  snapshot target/script-out/models/02-teapot-normals.png
at 21  set 1/clip/material 2
at 30  snapshot target/script-out/models/03-teapot-chrome.png
at 31  set 1/clip/material 3
at 40  snapshot target/script-out/models/04-teapot-toon.png
at 41  set 1/clip/material 4
at 50  snapshot target/script-out/models/05-teapot-hologram.png
at 51  set 1/clip/material 5
at 60  snapshot target/script-out/models/06-teapot-wireframe.png

# Textured models: OBJ + MTL + PNG, and a glTF binary loaded from a file path.
at 61  model 1 2 Spot
at 61  launch 1 2
at 61  set "1/clip/spin y" 0
at 61  set "1/clip/rotate y" -40
at 70  snapshot target/script-out/models/07-spot-textured.png
at 71  load 1 3 assets/models/fox.glb
at 71  launch 1 3
at 71  set "1/clip/spin y" 0
at 71  set "1/clip/rotate y" -60
at 80  snapshot target/script-out/models/08-fox-gltf.png

# Deformers and the wire overlay on a scan.
at 81  model 1 4 Stanford Bunny
at 81  launch 1 4
at 81  set "1/clip/spin y" 0
at 81  set 1/clip/wire 0.6
at 90  snapshot target/script-out/models/09-bunny-wire.png
at 91  set 1/clip/wire 0
at 91  set 1/clip/explode 0.15
at 91  set 1/clip/shading 1
at 100 snapshot target/script-out/models/10-bunny-explode.png
at 101 model 1 5 Torus Knot
at 101 launch 1 5
at 101 set 1/clip/twist 1
at 101 set 1/clip/material 2
at 110 snapshot target/script-out/models/11-knot-twist-chrome.png

# The Shape projector, with a model as its object: the photo wrapped onto it.
at 111 stop 1
at 111 load 2 1 samples/pillars-of-creation.jpg
at 111 launch 2 1
at 111 add-effect 2 "shape projector"
at 111 effect-model 2/shape Stanford Dragon
at 111 set "2/shape/spin y" 0
at 111 set "2/shape/rotate y" 60
at 111 set 2/shape/background 2
at 111 set 2/shape/size 0.8
at 111 assert 2/shape/shape == 3
at 120 snapshot target/script-out/models/12-shape-dragon-box.png
at 121 effect-model 2/shape Spot
at 121 set 2/shape/model mapping 1     # the cow's own UVs
at 130 snapshot target/script-out/models/13-shape-spot-uvs.png
at 131 effect-model 2/shape Torus
at 131 set 2/shape/model mapping 0     # auto: the torus has UVs
at 131 set 2/shape/background 1        # over the input
at 131 set 2/shape/size 0.6
at 140 snapshot target/script-out/models/14-shape-torus-over-input.png

# Projection mapping: a projector throws a checkerboard at a model, which shadows the wall.
at 141 stop 2
at 141 generator 3 1 Checker
at 141 launch 3 1
at 141 set 3/clip/frequency 8
at 141 set 3/clip/pattern speed 0
at 141 add-effect 3 "projection mapping"
at 141 effect-model 3/projection Happy Buddha
at 141 set "3/projection/spin y" 0
at 141 set "3/projection/rotate x" 0
at 141 set "3/projection/rotate y" 0
at 141 assert 3/projection/shape == 4
at 150 snapshot target/script-out/models/15-projection-buddha.png
at 151 effect-model 3/projection Armadillo
at 151 set "3/projection/projector angle" -50
at 160 snapshot target/script-out/models/16-projection-armadillo-left.png

# The browser's Models tab, and the device panel with the model picker.
at 161 select 3 1
at 161 library models
at 170 screenshot target/script-out/models/17-ui-models.png
at 175 library models math
at 180 screenshot target/script-out/models/18-ui-math.png
at 181 quit
