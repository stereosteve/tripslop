# Dry/wet on effects: an inverting Color effect on a solid colour, mixed in different ways.
# Run from the repo root:  cargo run --release -- --script scripts/dry-wet.tripslop
#
# The solid generator at hue 0 has luma ~0.416, so fully inverted it's ~0.584. Output is 8-bit,
# so the checks allow a couple of steps either side.

generator 1 1 Solid
launch 1 1
add-effect 1 Color
set 1/color/invert 1

# Fully wet (the default): inverted.
at 5  assert output 0.5 0.5 > 0.575
at 5  assert output 0.5 0.5 < 0.593

# Wet 0: the effect still runs but the dry picture comes through.
at 6  set 1/color/wet 0
at 10 assert output 0.5 0.5 > 0.407
at 10 assert output 0.5 0.5 < 0.425

# Halfway with Normal is a straight dissolve: halfway between a colour and its inverse is grey.
at 11 set 1/color/wet 0.5
at 15 assert output 0.5 0.5 > 0.49
at 15 assert output 0.5 0.5 < 0.51
at 15 snapshot target/script-out/dry-wet/normal-half.png

# Add at 0.5: dry + half the inverse, per channel 0.5 + 0.5 * dry, so luma ~0.708.
at 16 set 1/color/wet blend 1
at 20 assert 1/color/wet blend == 1
at 20 assert output 0.5 0.5 > 0.698
at 20 assert output 0.5 0.5 < 0.718
at 20 snapshot target/script-out/dry-wet/add-half.png

# The wet amount is an ordinary parameter: an LFO sweeps it.
# Depth 1, one beat per cycle, around 0.5: the top of the sine is fully wet.
at 21 automate 1/color/wet sine 1 1
at 21 set 1/color/wet blend 0
at 2.25b assert 1/color/wet > 0.95
at 2.75b assert 1/color/wet < 0.05
at 2b screenshot target/script-out/dry-wet/ui.png
at 3b quit
