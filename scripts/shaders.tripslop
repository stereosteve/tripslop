# Every shader template, a WGSL file, and GLSL / ISF shaders used as effects.

shader 1 1 "Shadertoy default"
shader 1 2 "Plasma"
shader 1 3 "Beat tunnel"
shader 1 4 "Feedback ripples"
shader 1 5 "WGSL starter"
shader 1 6 "GLSL Sandbox"
load   1 7 src/shaders/marble.wgsl

load 2 1 samples/pillars-of-creation.jpg
add-effect 2 "shader:ISF filter"
add-effect 2 "shader:Input: RGB shift"
set 2/scale 0.5
launch 2 1

# Shaders compile in the background; give them a moment.
at 30 assert errors 1 1 == 0
assert errors 1 2 == 0
assert errors 1 3 == 0
assert errors 1 4 == 0
assert errors 1 5 == 0
assert errors 1 6 == 0
assert errors 1 7 == 0
set 2/isf/amount 0.05
assert 2/isf/amount ~= 0.05
assert 1/clip2/speed ~= 1               # template sliders: Plasma's "speed"

at 40  launch 1 1
at 70  snapshot target/script-out/shaders/1-shadertoy-default.png
at 80  launch 1 2
at 110 snapshot target/script-out/shaders/2-plasma.png
at 120 launch 1 3
at 150 snapshot target/script-out/shaders/3-beat-tunnel.png
at 160 launch 1 4
at 190 snapshot target/script-out/shaders/4-feedback-ripples.png
at 200 launch 1 5
at 230 snapshot target/script-out/shaders/5-wgsl-starter.png
at 240 launch 1 6
at 270 snapshot target/script-out/shaders/6-glsl-sandbox.png
at 280 launch 1 7
at 310 snapshot target/script-out/shaders/7-marble-wgsl.png

at 320 open-editor 1 3
at 330 screenshot target/script-out/shaders/editor.png
quit
