# The bundled shader library: generators and effects by name, and the browser.
# Run from the repo root:  cargo run --release -- --script scripts/library.tripslop

isf 1 1 Figure Eight                  # Three-Body Orbits
isf 2 1 Sphere Cluster                # uses ghost-arcade's audioBeat (follows the tempo here)
set 2/opacity 0.6
add-effect 2 "isf:Crystal Refract"    # an effect that re-declares TIME / RENDERSIZE
launch-scene 1
library generators

at 60  assert errors 1 1 == 0
at 60  assert errors 2 1 == 0
at 60 snapshot target/script-out/library/output.png
at 60 screenshot target/script-out/library/generators.png
# A screenshot arrives a frame or two after it's asked for: change views a few ticks later.
at 65 library effects
at 70 screenshot target/script-out/library/effects.png
at 75 library generators three-body orbits
at 80 screenshot target/script-out/library/three-body.png
at 80 quit
